---
import { getCollection } from "astro:content";
import { readFileSync } from "node:fs";
import BaseLayout from "../layouts/BaseLayout.astro";
import { LandingPage } from "../react/SiteApp";
import { SITE_LINKS } from "../react/site-content";

const packageJson = JSON.parse(
  readFileSync(new URL("../../../../package.json", import.meta.url), "utf8"),
) as { version?: string };
const appVersion = packageJson.version ?? "0.0.0";

function dateTime(value: unknown): number {
  if (!value) return 0;
  const date = value instanceof Date ? value : new Date(String(value));
  return Number.isNaN(date.getTime()) ? 0 : date.getTime();
}

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => dateTime(b.data.publishedAt) - dateTime(a.data.publishedAt),
);

const recentPosts = posts.slice(0, 3).map((post) => {
  const date = post.data.publishedAt
    ? new Date(String(post.data.publishedAt))
    : null;
  return {
    slug: post.data.slug ?? post.id,
    title: post.data.title,
    description: post.data.description,
    publishedAt:
      date && !Number.isNaN(date.getTime())
        ? date.toISOString().slice(0, 10)
        : null,
  };
});
---

<BaseLayout
  page="landing"
  title="Totem — Twitter / X Bookmarks on Your New Tab"
  description="Your Twitter bookmarks show up on every new tab, ready to read — locally, without opening X."
  canonical="https://usetotem.xyz/"
  og={{
    type: "website",
    image: "https://usetotem.xyz/icons/icon-128.png",
  }}
  twitter={{
    image: "https://usetotem.xyz/icons/icon-128.png",
  }}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      name: "Totem",
      description:
        "Your Twitter bookmarks show up on every new tab, ready to read — locally, without opening X.",
      applicationCategory: "BrowserApplication",
      applicationSubCategory: "Productivity",
      operatingSystem: "Google Chrome",
      softwareVersion: appVersion,
      isAccessibleForFree: true,
      offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
      url: "https://usetotem.xyz",
      downloadUrl: SITE_LINKS.chromeWebStoreListingUrl,
      publisher: { "@id": "https://usetotem.xyz/#organization" },
      aggregateRating: {
        "@type": "AggregateRating",
        ratingValue: "5.0",
        ratingCount: 1,
      },
    })} />
  </Fragment>
  <LandingPage client:load recentPosts={recentPosts} />
</BaseLayout>
