---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Totem — Page not found"
  description="This page doesn't exist. Head back to the Totem homepage."
  canonical="https://usetotem.xyz/404"
  robots="noindex"
>
  <main class="mx-auto flex min-h-[60vh] max-w-2xl flex-col items-center justify-center px-6 text-center">
    <p class="text-sm uppercase tracking-[0.18em] opacity-60">404</p>
    <h1 class="mt-3 text-3xl font-semibold">Page not found</h1>
    <p class="mt-3 opacity-70">
      The page you're looking for doesn't exist or has moved.
    </p>
    <p class="mt-6">
      <a href="/" class="underline underline-offset-4">Back to the homepage</a>
    </p>
  </main>
</BaseLayout>
