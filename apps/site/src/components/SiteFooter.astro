---
import { SITE_COPY, SITE_LINKS } from "../react/site-content";

const { footer, header } = SITE_COPY;
const linkClass =
  "rounded-sm text-xs text-neutral-600 no-underline transition-colors duration-200 hover:text-neutral-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/30";
---

<footer class="border-t border-neutral-200">
  <div
    class="mx-auto flex w-full max-w-5xl flex-wrap items-center justify-between gap-x-6 gap-y-2 px-6 py-3.5 text-sm text-neutral-600"
  >
    <a
      href="/"
      class="flex items-center gap-2 no-underline"
      aria-label={footer.brandAriaLabel}
    >
      <span class="totem-logo size-5" aria-hidden="true">
        <svg viewBox="0 0 100 100" fill="none">
          <defs>
            <linearGradient id="totem-shine-footer" x1="0" y1="0" x2="0.3" y2="1">
              <stop offset="0%" stop-color="white" stop-opacity="0.45" />
              <stop offset="50%" stop-color="white" stop-opacity="0.1" />
              <stop offset="100%" stop-color="white" stop-opacity="0" />
            </linearGradient>
          </defs>
          <rect width="100" height="100" rx="18" fill="#1c1c1e" />
          <path d="M20 80L80 80L80 20Z" fill="#e07a5f" />
          <path d="M80 20L52.5 47.5L80 80Z" fill="#c96b50" />
          <path d="M52.5 47.5L80 20" stroke="rgba(255,255,255,0.2)" stroke-width="1.5" />
          <path d="M20 80L80 80L80 20Z" fill="url(#totem-shine-footer)" />
        </svg>
      </span>
      <span class="text-xs font-semibold text-neutral-700">
        {header.brandName}
      </span>
    </a>

    <nav class="flex items-center gap-5" aria-label={footer.navAriaLabel}>
      <a href={SITE_LINKS.howItWorksUrl} class={linkClass}>How it works</a>
      <a href="/blog/" class={linkClass}>Blog</a>
      <a href={SITE_LINKS.privacyUrl} class={linkClass}>{footer.privacyLabel}</a>
      <a
        href={SITE_LINKS.supportEmailUrl}
        class={`${linkClass} inline-flex items-center justify-center`}
        aria-label="Email support"
        title="Email support"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 256 256"
          fill="currentColor"
          class="size-3.5"
          aria-hidden="true"
        >
          <path d="M224,48H32a8,8,0,0,0-8,8V192a16,16,0,0,0,16,16H216a16,16,0,0,0,16-16V56A8,8,0,0,0,224,48ZM98.71,128,40,181.81V74.19Zm11.84,10.85,12,11.05a8,8,0,0,0,10.82,0l12-11.05,46.46,42.6,1.71,1.55H50.46l1.71-1.55ZM157.29,128,216,74.19V181.81Zm54.19-64L128,140.59,44.52,64Z"></path>
        </svg>
      </a>
      <a
        href={SITE_LINKS.supportXUrl}
        target="_blank"
        rel="noopener noreferrer"
        class={`${linkClass} inline-flex items-center justify-center`}
        aria-label={`Open ${SITE_LINKS.supportXHandle} on X`}
        title={SITE_LINKS.supportXHandle}
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 256 256"
          fill="currentColor"
          class="size-3.5"
          aria-hidden="true"
        >
          <path d="M214.75,211.71l-62.6-98.38,61.77-67.95a8,8,0,0,0-11.84-10.76L143.24,99.34,102.75,35.71A8,8,0,0,0,96,32H48a8,8,0,0,0-6.75,12.29l62.6,98.38L42.08,210.62a8,8,0,1,0,11.84,10.76l58.84-64.72,40.49,63.63A8,8,0,0,0,160,224h48a8,8,0,0,0,6.75-12.29ZM164.39,208,62.57,48h29L193.43,208Z"></path>
        </svg>
      </a>
      <a
        href={SITE_LINKS.githubRepoUrl}
        target="_blank"
        rel="noopener noreferrer"
        class={`${linkClass} inline-flex items-center gap-1.5`}
      >
        <svg
          viewBox="0 0 16 16"
          fill="currentColor"
          class="size-3.5"
          aria-hidden="true"
        >
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"></path>
        </svg>
      </a>
    </nav>

    <p class="text-xs text-neutral-500">{footer.copyright}</p>
  </div>
</footer>
