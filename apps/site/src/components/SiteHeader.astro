---
import { SITE_COPY, SITE_LINKS } from "../react/site-content";

interface Props {
  page?: "landing" | "privacy" | "how-it-works" | "blog-index" | "blog-post";
}

const { page } = Astro.props;
const demoHref = page === "landing" ? "#demo" : "/#demo";
const { header } = SITE_COPY;
---

<header
  data-site-header
  class="sticky top-0 z-50 border-b border-neutral-200 bg-white transition-colors duration-200"
>
  <div
    class="mx-auto flex w-full max-w-5xl items-center justify-between gap-3 px-4 py-2 sm:gap-4 sm:px-6"
  >
    <a
      href="/"
      class="flex shrink-0 items-center gap-2.5 no-underline"
      aria-label={header.brandAriaLabel}
    >
      <span class="totem-logo size-7" aria-hidden="true">
        <svg viewBox="0 0 100 100" fill="none">
          <defs>
            <linearGradient id="totem-shine-header" x1="0" y1="0" x2="0.3" y2="1">
              <stop offset="0%" stop-color="white" stop-opacity="0.45" />
              <stop offset="50%" stop-color="white" stop-opacity="0.1" />
              <stop offset="100%" stop-color="white" stop-opacity="0" />
            </linearGradient>
          </defs>
          <rect width="100" height="100" rx="18" fill="#1c1c1e" />
          <path d="M20 80L80 80L80 20Z" fill="#e07a5f" />
          <path d="M80 20L52.5 47.5L80 80Z" fill="#c96b50" />
          <path d="M52.5 47.5L80 20" stroke="rgba(255,255,255,0.2)" stroke-width="1.5" />
          <path d="M20 80L80 80L80 20Z" fill="url(#totem-shine-header)" />
        </svg>
      </span>
      <span class="text-sm font-bold text-neutral-900">{header.brandName}</span>
    </a>

    <nav class="flex shrink-0 items-center gap-1.5 sm:gap-2" aria-label={header.navAriaLabel}>
      <a
        href={SITE_LINKS.installUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex h-11 items-center justify-center gap-2 whitespace-nowrap rounded-full bg-neutral-900 px-3 text-sm font-semibold text-white no-underline transition-colors duration-200 hover:bg-neutral-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/30 focus-visible:ring-offset-2 sm:px-4"
      >
        <svg
          viewBox="-0.82 0 437.46 437.46"
          xmlns="http://www.w3.org/2000/svg"
          class="size-4 shrink-0"
          aria-hidden="true"
        >
          <defs>
            <linearGradient
              id="chrome-logo-inner-header"
              gradientUnits="userSpaceOnUse"
              x1="216.802"
              y1="140.297"
              x2="216.802"
              y2="296.195"
            >
              <stop offset="0" stop-color="#a2c0e6" />
              <stop offset="1" stop-color="#406cb1" />
            </linearGradient>
          </defs>
          <path
            fill="#c6352e"
            d="M217.341.039s128.478-5.783 196.57 123.337H206.416s-39.188-1.289-72.593 46.255c-9.634 19.916-19.91 40.473-8.349 80.937C108.773 222.309 36.823 97.04 36.823 97.04S87.578 5.176 217.341.039z"
          />
          <path
            fill="#f4d911"
            d="M407.223 327.871s-59.247 114.143-205.118 108.533c17.995-31.148 103.772-179.682 103.772-179.682s20.709-33.289-3.744-85.991c-12.431-18.305-25.09-37.486-65.919-47.713 32.836-.326 177.285.021 177.285.021s54.168 89.891-6.276 204.832z"
          />
          <path
            fill="#81b354"
            d="M28.373 328.738s-69.224-108.395 8.58-231.908c17.979 31.16 103.71 179.72 103.71 179.72s18.469 34.578 76.341 39.756c22.061-1.609 45.007-2.982 74.279-33.223-16.139 28.594-88.673 153.521-88.673 153.521S97.681 438.56 28.373 328.738z"
          />
          <path
            fill="#7baa50"
            d="M202.105 437.46l29.187-121.793s32.092-2.504 58.982-32.017c-16.693 29.365-88.169 153.81-88.169 153.81z"
          />
          <path
            fill="#ffffff"
            d="M119.59 220.093c0-53.69 43.52-97.215 97.215-97.215 53.69 0 97.214 43.524 97.214 97.215 0 53.693-43.522 97.219-97.214 97.219-53.695 0-97.215-43.525-97.215-97.219z"
          />
          <path
            fill="url(#chrome-logo-inner-header)"
            d="M135.86 220.093c0-44.702 36.238-80.941 80.945-80.941 44.698 0 80.94 36.239 80.94 80.941 0 44.703-36.242 80.945-80.94 80.945-44.707.001-80.945-36.244-80.945-80.945z"
          />
          <path
            fill="#e7ce12"
            d="M413.5 123.039l-120.183 35.237s-18.123-26.596-57.104-35.258c33.776-.115 177.287.021 177.287.021z"
          />
          <path
            fill="#bc332c"
            d="M123.137 246.197c-16.89-29.25-86.31-149.16-86.31-149.16l89.029 88.07s-9.149 18.82-5.68 45.7l2.961 15.39z"
          />
        </svg>
        <span class="hidden min-[380px]:inline">{header.installLabel}</span>
        <span class="min-[380px]:hidden">Add</span>
      </a>
      <a
        href={demoHref}
        class="inline-flex h-11 items-center justify-center gap-2 whitespace-nowrap rounded-full border border-neutral-200 bg-white px-3 text-sm font-semibold text-neutral-900 no-underline transition-colors duration-200 hover:bg-neutral-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/30 focus-visible:ring-offset-2 sm:px-4"
      >
        <span class="hidden min-[380px]:inline">{header.demoLabel}</span>
        <span class="min-[380px]:hidden">Demo</span>
      </a>
    </nav>
  </div>
</header>

<script is:inline>
  (function () {
    const el = document.querySelector("[data-site-header]");
    if (!el) return;
    let ticking = false;
    function update() {
      ticking = false;
      const scrolled = window.scrollY > 20;
      el.classList.toggle("bg-white/90", scrolled);
      el.classList.toggle("backdrop-blur-md", scrolled);
      el.classList.toggle("bg-white", !scrolled);
    }
    function onScroll() {
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(update);
    }
    update();
    window.addEventListener("scroll", onScroll, { passive: true });
  })();
</script>
