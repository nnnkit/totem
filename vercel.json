{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build:website",
  "outputDirectory": "dist-website",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/demo-data.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/website/:path*",
      "destination": "/:path*",
      "permanent": false
    }
  ]
}
