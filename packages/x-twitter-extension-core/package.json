{
  "name": "@make/x-twitter-extension-core",
  "version": "0.0.0",
  "description": "Private X web-extension primitives for auth, URL parsing, and GraphQL query-id catalogs.",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "pnpm typecheck",
    "prepack": "pnpm test && pnpm typecheck"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./pure": {
      "types": "./src/pure.ts",
      "import": "./src/pure.ts"
    },
    "./auth": {
      "types": "./src/auth.ts",
      "import": "./src/auth.ts"
    },
    "./auth-primitives": {
      "types": "./src/auth-primitives.ts",
      "import": "./src/auth-primitives.ts"
    },
    "./query-id": {
      "types": "./src/query-id.ts",
      "import": "./src/query-id.ts"
    }
  },
  "devDependencies": {
    "typescript": "5.7.2",
    "vitest": "3.2.4"
  }
}
